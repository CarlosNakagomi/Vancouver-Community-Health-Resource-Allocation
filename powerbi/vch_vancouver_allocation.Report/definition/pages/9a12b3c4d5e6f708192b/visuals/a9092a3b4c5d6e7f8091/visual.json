              },
              {
                "textRuns": [
                  {
                    "value": "45% Vulnerability Proxy + 25% Data Blindspot + 30% Healthcare Supply Gap = Resource Priority Score",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "fontWeight": "bold",
                      "color": "#2E5F91"
                    }
                  },
                  {
                    "value": "\nComponent contributions remain visible so users can see why a community ranks highly. These weights are explicit assumptions, not validated allocation coefficients.\n\n",
