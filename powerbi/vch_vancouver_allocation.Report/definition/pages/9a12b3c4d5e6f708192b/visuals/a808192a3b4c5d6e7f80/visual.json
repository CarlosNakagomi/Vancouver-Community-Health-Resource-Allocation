          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "What the Scores Mean",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16px",
                      "fontWeight": "bold",
                      "color": "#123B6D"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Vulnerability Proxy Score",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "fontWeight": "bold",
                      "color": "#20364D"
                    }
                  },
                  {
                    "value": "\nRelative age-structure proxy. Not clinical need, deprivation or a validated multidimensional vulnerability index.\n\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "fontWeight": "normal",
                      "color": "#20364D"
                    }
                  },
                  {
                    "value": "Data Blindspot Score",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "fontWeight": "bold",
                      "color": "#20364D"
                    }
                  },
                  {
                    "value": "\nRelative census non-response signal. Higher values mean greater data uncertainty—not disadvantage, clinical vulnerability or poor access.\n\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "fontWeight": "normal",
                      "color": "#20364D"
                    }
                  },
                  {
                    "value": "Healthcare Supply Gap Score",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "fontWeight": "bold",
                      "color": "#20364D"
                    }
                  },
                  {
                    "value": "\nInverse signal from mapped facility locations per resident. Higher values mean fewer mapped locations relative to population—not capacity, quality, access or unmet need.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "fontWeight": "normal",
                      "color": "#20364D"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
      ]
    },
