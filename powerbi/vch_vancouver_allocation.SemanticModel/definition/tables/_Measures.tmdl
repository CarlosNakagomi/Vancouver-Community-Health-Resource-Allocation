table _Measures
	lineageTag: 4e5d491e-e0ed-4797-885a-199bc7039eca

	measure 'Total Population' = SUM ( 'FactCommunityProfile'[CHSPOP_CEN] )
		formatString: 0.0
		displayFolder: Core metrics
		lineageTag: 2d64b718-ad4f-47d6-b471-b45faa6e6906

	measure 'Total Facilities' = SUM ( 'FactFacilitySupply'[FacilityCount] )
		displayFolder: Core metrics
		lineageTag: 183de880-337d-402d-bf13-7a210a66bc60

	measure 'Total CHSAs' = DISTINCTCOUNT ( DimCHSA[CHSA Code] )
		displayFolder: Core metrics
		lineageTag: 644d57d6-d646-434a-941a-66b997e42cbd

	measure 'Facilities per 10K Population' = DIVIDE ( [Total Facilities] * 10000, [Total Population] )
		formatString: 0.00
		displayFolder: Core metrics
		lineageTag: a124bb7b-5ae9-4269-aaa0-a14f0a2b88d0

	measure 'Population per Facility' = DIVIDE ( [Total Population], [Total Facilities] )
		displayFolder: Core metrics
		lineageTag: c656a40c-9727-4522-8310-c27c38676c19

	measure 'Youth Population' = SUM ( 'FactCommunityProfile'[0_14_A_TTL] )
		displayFolder: Core metrics
		lineageTag: 4ceb5b63-d1a7-41b5-b840-9982d8d1a0c6

	measure 'Senior Population' = SUM ( 'FactCommunityProfile'[65PLS_A_TL] )
		displayFolder: Core metrics
		lineageTag: dd817e9f-b7fb-4187-bf12-9e05a8913884

	measure 'Age Sample Population' = SUM ( 'FactCommunityProfile'[GRP_A_TTL] )
		displayFolder: Core metrics
		lineageTag: 6aa16dfe-27f1-4b3e-b727-a84e03d152f2

	measure 'Youth %' = DIVIDE ( [Youth Population], [Age Sample Population] )
		formatString: 0.0%
		displayFolder: Core metrics
		lineageTag: 556c5b5a-f315-4acc-aed0-19deb3ee9264

	measure 'Senior %' = DIVIDE ( [Senior Population], [Age Sample Population] )
		formatString: 0.0%
		displayFolder: Core metrics
		lineageTag: be564373-3d33-4c87-b400-c7b07c98f194

	measure 'Weighted GNR' = DIVIDE ( SUMX ( FactCommunityProfile, 'FactCommunityProfile'[LG_FRM_GNR] * 'FactCommunityProfile'[CHSPOP_CEN] ), [Total Population] )
		formatString: 0.00\%
		displayFolder: Core metrics
		lineageTag: 508401c9-b4c8-4a20-b9ca-047aabb03b3f

	measure 'Vulnerability Proxy Score' = AVERAGE ( 'FactCommunityProfile'[CommunityVulnerabilityProxyScore] )
		displayFolder: Transparent scores
		lineageTag: ac5a5fa0-68fe-4330-98b6-f6959ea10c9b

	measure 'Data Blindspot Score' = AVERAGE ( 'FactCommunityProfile'[DataBlindspotScore] )
