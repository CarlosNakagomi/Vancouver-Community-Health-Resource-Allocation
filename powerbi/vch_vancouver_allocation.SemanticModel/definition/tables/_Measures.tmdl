	measure 'Minimum Scenario Rank' = MIN ( FactPrioritySensitivity[Priority Rank] )
		formatString: 0
		displayFolder: Sensitivity analysis
		lineageTag: 5db7a957-3499-497e-87d2-49b63538a819

	measure 'Maximum Scenario Rank' = MAX ( FactPrioritySensitivity[Priority Rank] )
		formatString: 0
		displayFolder: Sensitivity analysis
		lineageTag: 44878e78-7696-4276-a062-0fc239063aca

	measure 'Scenario Rank Range' = [Maximum Scenario Rank] - [Minimum Scenario Rank]
		formatString: 0
		displayFolder: Sensitivity analysis
		lineageTag: d563ed0e-2ad3-466a-8f5f-ffed025d9840

	measure 'Top-5 Scenario Count' = CALCULATE ( DISTINCTCOUNT ( FactPrioritySensitivity[Scenario] ), FactPrioritySensitivity[Priority Rank] <= 5 )
		formatString: 0
		displayFolder: Sensitivity analysis
		lineageTag: b797b476-bd7f-408f-8e4c-1eeb072d5b7c

	measure 'Balanced Rank' = CALCULATE ( MIN ( FactPrioritySensitivity[Priority Rank] ), FactPrioritySensitivity[Scenario] = "Balanced" )
		formatString: 0
		displayFolder: Sensitivity analysis
		lineageTag: 6c796ba4-c632-45d8-b146-810e9c0dbc1c

	measure 'Need-focused Rank' = CALCULATE ( MIN ( FactPrioritySensitivity[Priority Rank] ), FactPrioritySensitivity[Scenario] = "Need-focused" )
		formatString: 0
		displayFolder: Sensitivity analysis
		lineageTag: 903367da-57cd-4dfa-9d37-ddfe04057e59

	measure 'Uncertainty-aware Rank' = CALCULATE ( MIN ( FactPrioritySensitivity[Priority Rank] ), FactPrioritySensitivity[Scenario] = "Uncertainty-aware" )
		formatString: 0
		displayFolder: Sensitivity analysis
		lineageTag: f09a5d12-1005-48ac-971e-66465b71e2fc

	measure 'Supply-gap-focused Rank' = CALCULATE ( MIN ( FactPrioritySensitivity[Priority Rank] ), FactPrioritySensitivity[Scenario] = "Supply-gap-focused" )
		formatString: 0
		displayFolder: Sensitivity analysis
		lineageTag: 4dca950d-6c0a-4930-a1a3-1b3a2fe635b3

	measure 'Passed Controls' = CALCULATE ( COUNTROWS ( ValidationResults ), ValidationResults[Status] = "PASS" )
		formatString: 0
		displayFolder: Data quality
		lineageTag: 35b973a4-64b4-46ee-a8ff-81cc2d4d907c

	measure 'Failed Controls' = COALESCE ( CALCULATE ( COUNTROWS ( ValidationResults ), ValidationResults[Status] = "FAIL" ), 0 )
		formatString: 0
		displayFolder: Data quality
		lineageTag: d2768a0f-eed0-4308-b93e-4372dfc4db77

	measure 'Null Retained Spatial Assignments' = COUNTROWS ( FILTER ( DimFacility, ISBLANK ( DimFacility[CMNTY_HLTH_SERV_AREA_CODE] ) ) )
		formatString: 0
		displayFolder: Data quality
		lineageTag: bb5c306d-ad99-4771-b8f8-cf5f6aec6a85

	measure 'Edge-tolerance Assignments' = CALCULATE ( COUNTROWS ( DimFacility ), DimFacility[SpatialAssignmentStatus] = "Assigned to nearest polygon edge within 25 m tolerance" )
		formatString: 0
		displayFolder: Data quality
		lineageTag: 18adb792-5ddf-4121-823b-baf92972efc3

