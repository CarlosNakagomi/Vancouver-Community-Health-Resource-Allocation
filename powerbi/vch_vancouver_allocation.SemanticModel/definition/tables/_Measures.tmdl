	measure 'Budget Reconciliation' = [Scenario Budget Allocation] - 10000000
		isHidden
		displayFolder: Scenario model - not actual VCH resources
		lineageTag: 96dadfbb-c0b2-428e-a011-b43c3bb4c2d1

	measure 'Clinical FTE Reconciliation' = [Scenario Clinical FTE Allocation] - 50
